# PostgreSQL connection string. See README for local/hosted setup options.
DATABASE_URL="postgresql://user:password@localhost:5432/kungfu_dev?schema=public"

# Auth.js — generate with: npx auth secret (or `openssl rand -base64 32`)
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# TMDB — get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# Shared secret checked against the Authorization header on /api/cron/weekly-featured
CRON_SECRET=""

# Email (for account verification) — optional. Without it, verification links
# are logged to the server console instead of emailed. See README for setup
# with Resend (or swap in your own provider in src/lib/email.ts).
RESEND_API_KEY=""
EMAIL_FROM=""

# Vercel Blob (for admin poster overrides) — optional. Create a Blob store in
# your Vercel project's Storage tab, then `vercel env pull` to get this
# locally. See README for details.
BLOB_READ_WRITE_TOKEN=""

# Upstash Redis (for rate limiting) — optional. Without it, rate limiting is
# a no-op (every request is allowed) rather than blocking everything. Create
# a free database at https://console.upstash.com and copy its REST URL/token.
# See README for details.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare Turnstile (CAPTCHA on registration and forgot-password) —
# optional. Without it, no CAPTCHA is shown or required. Create a free
# widget at https://dash.cloudflare.com/?to=/:account/turnstile. The site
# key is public (exposed to the browser); the secret key is server-only.
# See README for details.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
